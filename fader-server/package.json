{
  "name": "fader-server",
  "private": true,
  "version": "0.1.0",
  "description": "Тестовый локальный сервер для Fader UI: принимает значения фейдера по WebSocket и логирует их",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "load": "tsx src/load-test.ts"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "express": "^5.1.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
